# Base de datos
MONGO_URI=mongodb://mongo:27017
MONGO_DB=deskly

# Secreto compartido para firmar el webhook (HMAC-SHA256). Cámbialo por un valor aleatorio.
WEBHOOK_SECRET=cambia-este-secreto

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend (URLs que usa el navegador para llegar al backend)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/tickets
